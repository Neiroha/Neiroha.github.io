{
  "name": "neiroha-wiki",
  "version": "0.1.0",
  "private": true,
  "description": "Docusaurus wiki for Neiroha on GitHub Pages.",
  "scripts": {
    "start": "docusaurus start --host 0.0.0.0",
    "start:en": "docusaurus start --host 0.0.0.0 --locale en",
    "build": "docusaurus build",
    "build:zh": "docusaurus build --locale zh-Hans",
    "build:en": "docusaurus build --locale en",
    "serve": "docusaurus serve --host 0.0.0.0"
  },
  "dependencies": {
    "@docusaurus/core": "^3.8.1",
    "@docusaurus/preset-classic": "^3.8.1",
    "@mdx-js/react": "^3.1.0",
    "clsx": "^2.1.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 3 safari version"
    ]
  }
}
